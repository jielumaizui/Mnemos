# Mnemos - Local AI Knowledge System Environment Configuration
# This file is auto-generated from core/config.py and core/llm_config.py.
# Copy this file to .env and fill in your actual values.

# ------------------------------------------------------------
# Base Paths
# ------------------------------------------------------------
# Mnemos 数据根目录（默认 ~/.mnemos）
# MNEMOS_DIR=
# Obsidian / Mnemos vault 路径
# MNEMOS_WIKI_DIR=
# 运行时数据库/日志目录（覆盖 system.database_dir）
# MNEMOS_DATABASE_DIR=

# ------------------------------------------------------------
# Performance
# ------------------------------------------------------------
# 性能档位：eco / default / performance / dev
# MNEMOS_PERFORMANCE_TIER=

# ------------------------------------------------------------
# Preflight / Oracle / Push / Cache
# ------------------------------------------------------------
# preflight 超时秒数
# MNEMOS_PREFLIGHT_TIMEOUT_SEC=
# wiki 索引缓存 TTL（秒）
# MNEMOS_WIKI_INDEX_CACHE_TTL=
# push 索引缓存 TTL（秒）
# MNEMOS_PUSH_INDEX_CACHE_TTL=
# Obsidian vault 扫描缓存 TTL（秒）
# MNEMOS_OBSIDIAN_CACHE_TTL=
# Obsidian 扫描缓存最大条目数
# MNEMOS_OBSIDIAN_CACHE_MAX_ENTRIES=

# ------------------------------------------------------------
# Retention Days
# ------------------------------------------------------------
# observations 保留天数
# MNEMOS_RETENTION_DAYS_OBSERVATIONS=
# reflections 保留天数
# MNEMOS_RETENTION_DAYS_REFLECTIONS=
# user_signals 保留天数
# MNEMOS_RETENTION_DAYS_USER_SIGNALS=
# application_signals 保留天数
# MNEMOS_RETENTION_DAYS_APPLICATION_SIGNALS=
# knowledge_graph 保留天数
# MNEMOS_RETENTION_DAYS_KNOWLEDGE_GRAPH=
# wiki_metrics_query_log 保留天数
# MNEMOS_RETENTION_DAYS_WIKI_METRICS_QUERY_LOG=
# mnemos_search_sessions 保留天数
# MNEMOS_RETENTION_DAYS_MNEMOS_SEARCH_SESSIONS=
# link_probe_queue 保留天数
# MNEMOS_RETENTION_DAYS_LINK_PROBE_QUEUE=
# model_call_ledger 保留天数
# MNEMOS_RETENTION_DAYS_MODEL_CALL_LEDGER=
# distillation_chunks 保留天数
# MNEMOS_RETENTION_DAYS_DISTILLATION_CHUNKS=

# ------------------------------------------------------------
# Persona
# ------------------------------------------------------------
# 画像 A/B 测试开关 true/false
# MNEMOS_PERSONA_AB_TEST=

# ------------------------------------------------------------
# Legacy / Migration
# ------------------------------------------------------------
# MNEMOS_WIKI_DIR 的兼容别名
# WIKI_DIR=
# 遗留 L1 外部存储 API URL
# L1_STORAGE_API_URL=
# 遗留 L1 外部存储 Token
# L1_STORAGE_TOKEN=
# Claude Code settings.json 路径
# CLAUDE_SETTINGS_JSON=

# ------------------------------------------------------------
# Required Model Endpoints
# ------------------------------------------------------------
# LLM（对话/蒸馏模型）API key
# MNEMOS_LLM_API_KEY=
# LLM 模型 API 地址
# MNEMOS_LLM_BASE_URL=
# LLM 模型 ID
# MNEMOS_LLM_MODEL=
# Embedding（向量/语义召回模型）API key
# MNEMOS_EMBEDDING_API_KEY=
# Embedding 模型 API 地址
# MNEMOS_EMBEDDING_BASE_URL=
# Embedding 模型 ID
# MNEMOS_EMBEDDING_MODEL=
# Reranker（搜索重排模型）API key
# MNEMOS_RERANKER_API_KEY=
# Reranker 模型 API 地址
# MNEMOS_RERANKER_BASE_URL=
# Reranker 模型 ID
# MNEMOS_RERANKER_MODEL=

# ------------------------------------------------------------
# Optional Multimodal Model
# ------------------------------------------------------------
# 可选多模态/视觉模型 API key
# MNEMOS_MULTIMODAL_API_KEY=
# 可选多模态/视觉模型 API 地址
# MNEMOS_MULTIMODAL_BASE_URL=
# 可选多模态/视觉模型 ID
# MNEMOS_MULTIMODAL_MODEL=

# ------------------------------------------------------------
# Agent Source Homes
# ------------------------------------------------------------
# Kimi 会话数据目录
# KIMI_HOME=
# Hermes 数据目录
# HERMES_HOME=
# Cursor 数据目录
# CURSOR_HOME=
# Gemini 数据目录
# GEMINI_HOME=
# Windsurf 数据目录
# WINDSURF_HOME=
# Aider 项目根目录（逗号分隔）
# AIDER_PROJECT_ROOTS=

# ------------------------------------------------------------
# Runtime / Integration
# ------------------------------------------------------------
# 宿主 Agent 标识
# MNEMOS_HOST_AGENT=
# Hook 事件名
# MNEMOS_HOOK_EVENT=
# MCP 启动能力引用（运行时注入，示例留空）
# MNEMOS_MCP_LAUNCH_CAPABILITY_REF=
# 存储后端插件模块列表（逗号分隔）
# MNEMOS_STORAGE_BACKEND_PLUGINS=

# ------------------------------------------------------------
# Generic Overrides
# ------------------------------------------------------------
# 通用配置覆盖，如 MNEMOS_DISTILL__MAX_TASKS_PER_CYCLE=10
